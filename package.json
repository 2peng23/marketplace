{
  "name": "marketplace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:seed": "tsx scripts/seed.ts",
    "email:setup": "tsx scripts/configure-email.ts",
    "stripe:setup": "tsx scripts/configure-stripe.ts",
    "stripe:webhook": "node --env-file=.env.local scripts/create-webhook.mjs",
    "test:payments:database": "RUN_PAYMENT_DATABASE_TESTS=true tsx --conditions=react-server --test tests/payments-database.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "smtp-server": "^3.21.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
